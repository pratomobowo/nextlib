# =============================================================================
# NextLib-Agent Configuration
# =============================================================================
# Copy this file to .env and fill in the actual values.
# This file must NOT be placed in a web-accessible directory.
# Loaded by vlucas/phpdotenv from index.php / cron.php.
# =============================================================================

# -----------------------------------------------------------------------------
# NextLib-Cloud Connection
# -----------------------------------------------------------------------------
# Base URL of the NextLib-Cloud SaaS server (must be HTTPS in production)
NEXTLIB_CLOUD_URL="https://cloud.nextlib.id"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# HMAC-SHA256 secret key shared with NextLib-Cloud. Used to sign all requests
# between the agent and the cloud. Obtain it from the NextLib-Cloud dashboard
# after tenant registration.
NEXTLIB_TOKEN_SECRET="your-tenant-token-secret-here"

# Tenant UUID assigned by NextLib-Cloud during onboarding.
NEXTLIB_TENANT_ID="00000000-0000-0000-0000-000000000000"

# Token expiry window in seconds (default: 5 minutes / 300).
NEXTLIB_TOKEN_MAX_AGE=300

# HTTP client timeout in seconds when calling the cloud.
NEXTLIB_HTTP_TIMEOUT=5

# -----------------------------------------------------------------------------
# SLiMS Database
# -----------------------------------------------------------------------------
# Connection details for the local SLiMS MySQL/MariaDB database.
SLIMS_DB_HOST="localhost"
SLIMS_DB_PORT="3306"
SLIMS_DB_NAME="slims"
SLIMS_DB_USER="slims"
SLIMS_DB_PASS=""

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Enable debug mode (1/0). Disable in production.
NEXTLIB_DEBUG=0
